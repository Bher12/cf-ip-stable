# ============================================================
# cf-ip-stable 推送脚本（Windows）
# 用法：复制本文件为 git_sync.ps1，填入下方四个变量，main.py 会自动调用。
# ============================================================
$github_token = "your_github_personal_access_token_here"
$github_username = "your_github_username"
$repo_name = "your_repo_name"
$branch = "main"

$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
Set-Location $scriptDir

# 仅提交需要对外订阅 / 持久化的产物
git add -f ip.txt stability_state.json run_summary.json
$changes = git diff --cached --name-only
if (-not $changes) {
    Write-Host "没有需要提交的变更，跳过推送。"
    exit 0
}
git commit -q -m "update: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"

$remoteUrl = "https://$($github_token)@github.com/$($github_username)/$($repo_name).git"
git push $remoteUrl "HEAD:$($branch)" --force
Write-Host "✅ ip.txt 已推送到 GitHub（独立仓库）"
